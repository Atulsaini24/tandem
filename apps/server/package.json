{
  "name": "@canvas/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@canvas/doc": "workspace:*",
    "@canvas/sync": "workspace:*",
    "postgres": "^3.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "fast-check": "^4.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
