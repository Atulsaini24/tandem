# Copy to .env (gitignored). Values match docker-compose.yml's local dev container.
DATABASE_URL=postgres://canvas:canvas-dev@localhost:5433/canvas
PORT=8787
# Run several instances behind a load balancer: same DATABASE_URL, plus Redis.
REDIS_URL=redis://localhost:6380
# Require signed tokens (mint one with: pnpm --filter @canvas/server token --doc demo).
# AUTH_SECRET=change-me
